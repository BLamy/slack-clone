{
  "name": "slack-clone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Slack-style chat demo backed by the Durable Streams emulator from the BLamy/emulate submodule.",
  "scripts": {
    "build": "vite build",
    "dev": "node scripts/start-stack.mjs",
    "dev:client": "vite --host 127.0.0.1 --port 5173",
    "dev:app": "node src/server.mjs",
    "dev:emulate": "node emulate/packages/emulate/dist/index.js start --service durable-streams,auth0 --port 4100 --seed emulate.config.yaml",
    "setup:emulate": "pnpm --dir emulate install && pnpm --dir emulate --filter '@emulators/*' build && pnpm --dir emulate --filter emulate build",
    "test": "node scripts/run-playwright.mjs",
    "test:playwright": "playwright test",
    "test:storybook": "vitest --run",
    "record:replay": "node scripts/record-two-replays.mjs",
    "storybook": "storybook dev -p 6006",
    "storybook:screenshots": "node scripts/capture-storybook-screenshots.mjs",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@playwright/test": "^1.62.1",
    "@replayio/playwright": "^5.0.3",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/addon-vitest": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "playwright": "^1.62.1",
    "storybook": "^10.5.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.2.2",
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-aria-components": "^1.19.0",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  }
}
