{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stream-slack.invalid/schemas/connection-events.v1.schema.json",
  "title": "Stream Slack connection events v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "eventId",
    "eventType",
    "workspaceId",
    "actorId",
    "idempotencyKey",
    "sequence",
    "serverTimestamp",
    "connectionId",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "eventId": { "$ref": "#/$defs/opaqueId" },
    "eventType": {
      "enum": [
        "connection.created",
        "connection.rotated",
        "connection.disabled",
        "connection.deleted"
      ]
    },
    "workspaceId": { "$ref": "#/$defs/identifier" },
    "actorId": { "$ref": "#/$defs/identifier" },
    "idempotencyKey": { "$ref": "#/$defs/opaqueId" },
    "sequence": { "type": "integer", "minimum": 1 },
    "serverTimestamp": { "$ref": "#/$defs/timestamp" },
    "connectionId": { "$ref": "#/$defs/opaqueId" },
    "data": {
      "oneOf": [
        { "$ref": "#/$defs/createdData" },
        { "$ref": "#/$defs/rotatedData" },
        { "$ref": "#/$defs/terminalData" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "eventType": { "const": "connection.created" } }
      },
      "then": { "properties": { "data": { "$ref": "#/$defs/createdData" } } }
    },
    {
      "if": {
        "properties": { "eventType": { "const": "connection.rotated" } }
      },
      "then": { "properties": { "data": { "$ref": "#/$defs/rotatedData" } } }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "enum": ["connection.disabled", "connection.deleted"]
          }
        }
      },
      "then": { "properties": { "data": { "$ref": "#/$defs/terminalData" } } }
    }
  ],
