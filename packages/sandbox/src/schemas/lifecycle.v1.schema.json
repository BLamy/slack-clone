{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stream-slack.dev/schemas/sandbox-lifecycle.v1.json",
  "title": "Sandbox lifecycle state",
  "type": "object",
  "required": ["sandboxId", "runId", "invocationDigest", "lifecycle", "fence"],
  "properties": {
    "sandboxId": { "type": "string", "pattern": "^sb_[A-Za-z0-9._:-]{1,160}$" },
    "runId": { "type": "string", "pattern": "^rn_[A-Za-z0-9._:-]{1,120}$" },
    "invocationDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "lifecycle": {
      "enum": ["creating", "ready", "running", "suspended", "destroyed"]
    },
    "fence": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": false
}
